{
  "description": "Ask the primary agent for estimates, remind it to revise them, and record turn durations.",
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','eta_hook.py'),run_name='__main__')\"",
        "timeout": 10
      }]
    }],
    "PostToolUse": [{
      "hooks": [{
        "type": "command",
        "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','eta_hook.py'),run_name='__main__')\"",
        "timeout": 10
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','eta_hook.py'),run_name='__main__')\"",
        "timeout": 10
      }]
    }],
    "Interrupt": [{
      "hooks": [{
        "type": "command",
        "command": "python -c \"import os,runpy; runpy.run_path(os.path.join(os.environ['PLUGIN_ROOT'],'hooks','eta_hook.py'),run_name='__main__')\"",
        "timeout": 3
      }]
    }]
  }
}
