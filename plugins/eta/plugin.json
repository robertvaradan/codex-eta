{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "eta",
  "version": "0.1.0",
  "description": "A local, learning turn ETA timer for Codex desktop.",
  "author": { "name": "Robert Varadan" },
  "homepage": "https://github.com/robertvaradan/codex-eta",
  "repository": "https://github.com/robertvaradan/codex-eta",
  "license": "MIT",
  "keywords": ["codex", "timer", "eta", "productivity"],
  "extensions": {
    "com.openai": {
      "requires_local_executor": true,
      "hooks": "./hooks/hooks.json",
      "interface": {
        "displayName": "ETA",
        "shortDescription": "Learning turn timer",
        "longDescription": "Shows a small desktop companion timer for the current Codex turn. Estimates adjust while work runs and learn from completed turns in local SQLite storage. Requires Windows, Python 3.10 or later, and trusted Codex lifecycle hooks. The window is separate from Codex's model indicator.",
        "developerName": "Robert Varadan",
        "category": "Productivity",
        "capabilities": ["Estimate turn completion time", "Learn from local turn history"],
        "websiteURL": "https://github.com/robertvaradan/codex-eta",
        "supportURL": "https://github.com/robertvaradan/codex-eta/issues",
        "composerIcon": "./assets/icon.png",
        "logo": "./assets/icon.png"
      }
    }
  }
}
