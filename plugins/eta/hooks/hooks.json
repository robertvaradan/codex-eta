{
  "description": "Update ETA state at Codex turn boundaries.",
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/hooks/eta_hook.py\"",
        "timeout": 10
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/hooks/eta_hook.py\"",
        "timeout": 10
      }]
    }],
    "Interrupt": [{
      "hooks": [{
        "type": "command",
        "command": "python \"${PLUGIN_ROOT}/hooks/eta_hook.py\"",
        "timeout": 3
      }]
    }]
  }
}

